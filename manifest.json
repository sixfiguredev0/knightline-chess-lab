{
  "manifest_version": 3,
  "name": "Knightline · Chess Lab",
  "version": "4.8.1",
  "description": "Chess board analysis and animated suggestions for live games, puzzles, bots, and study boards.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chess.com/*",
    "https://www.chess.com/*",
    "https://lichess.org/*",
    "https://chess-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Knightline · Chess Lab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chess.com/*",
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "lib/chess.js",
        "appSettings.js",
        "engineController.js",
        "moveSelectionPolicy.js",
        "autoMoveController.js",
        "boardAdapter.js",
        "boardPosition.js",
        "boardReader.js",
        "app.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://chess-api.com; base-uri 'none'"
  }
}
