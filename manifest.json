{
  "manifest_version": 3,
  "name": "Knightline · Chess Lab",
  "version": "5.0.0",
  "description": "Local-first chess analysis with explicit board selection, complete move handling, and private diagnostics.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://chess.com/*",
    "https://www.chess.com/*",
    "https://lichess.org/*",
    "https://chess-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Knightline · Chess Lab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["lichessInputBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chess.com/*",
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "lib/chess.js",
        "appSettings.js",
        "contracts.js",
        "engineController.js",
        "moveSelectionPolicy.js",
        "autoMoveController.js",
        "boardAdapter.js",
        "boardPosition.js",
        "boardReader.js",
        "moveExecutor.js",
        "app.js",
        "panelStyles.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://chess-api.com; worker-src 'self'; base-uri 'none'"
  },
  "version_name": "5.0.0",
  "minimum_chrome_version": "116"
}
